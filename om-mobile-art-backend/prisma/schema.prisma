datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Enums ──

enum Role {
  CUSTOMER
  ADMIN
  EDITOR
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  PRINTING
  QUALITY_CHECK
  PACKED
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
  RETURNED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  PACKED
  READY_TO_SHIP
}

enum OrderPriority {
  NORMAL
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  CAPTURED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
  AUTOMATIC
}

enum CouponStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED
  SCHEDULED
  ARCHIVED
}

enum PaymentGateway {
  STRIPE
  RAZORPAY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

// ── Identity Domain ──

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         Role           @default(CUSTOMER)
  status       CustomerStatus @default(ACTIVE)
  name         String?
  phone        String?
  tags         Json @default("[]")
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?      // For soft deletes

  isEmailVerified         Boolean        @default(false)
  addresses               Address[]
  wishlist                WishlistItem[]
  cart                    Cart?
  orders                  Order[]
  couponUsages            CouponUsage[]
  reviews                 Review[]
  notifications           Notification[]
  activityLogs            AdminActivityLog[]
  settings                UserSettings?
  notificationPreferences NotificationPreferences?
  avatars                 UserAvatar[]
  activities              AccountActivity[]
  sessions                UserSession[]
  reservations            InventoryReservation[]
  notes                   CustomerNote[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationOtps   EmailVerificationOTP[]
  otps                    Otp[]
  payments                Payment[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN_OTP
  PASSWORD_RESET
  MOBILE_LOGIN
}

model Otp {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String?
  phone        String?
  purpose      OtpPurpose
  otpHash      String
  expiresAt    DateTime
  attempts     Int        @default(0)
  resendCount  Int        @default(0)
  lastResendAt DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([email, purpose])
  @@index([phone, purpose])
  @@map("otps")
}

model EmailVerificationOTP {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  resendCount Int       @default(0)
  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?

  @@index([userId])
  @@map("email_verification_otps")
}

model PendingRegistration {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  passwordHash String
  otpHash      String
  expiresAt    DateTime
  attempts     Int       @default(0)
  resendCount  Int       @default(0)
  lastResendAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([email])
  @@map("pending_registrations")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  ipAddress   String?
  userAgent   String? @db.Text
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([hashedToken])
  @@map("password_reset_tokens")
}

model CustomerNote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String   @default("Admin")
  content    String @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("customer_notes")
}

model Address {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String
  alternativePhone  String?
  companyName       String?
  gstNumber         String?
  addressLine1      String
  addressLine2      String?
  landmark          String?
  city              String
  state             String
  country           String
  pincode           String
  type              AddressType @default(HOME)
  isDefaultShipping Boolean     @default(false)
  isDefaultBilling  Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("addresses")
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language  String   @default("en")
  currency  String   @default("INR")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model NotificationPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingEmails    Boolean  @default(true)
  smsNotifications   Boolean  @default(true)
  whatsAppNotifications Boolean @default(false)
  pushNotifications  Boolean  @default(false)
  orderUpdates       Boolean  @default(true)
  deliveryUpdates    Boolean  @default(true)
  offers             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("notification_preferences")
}

model UserAvatar {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url             String @db.Text
  storageProvider String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  @@map("user_avatars")
}

model AccountActivity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  userAgent String? @db.Text
  details   String? @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("account_activities")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String? @db.Text
  deviceType   String?
  location     String?
  lastActiveAt DateTime @default(now())
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([userId])
  @@map("user_sessions")
}

// ── Catalog Domain ──

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model ProductType {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  icon        String?
  thumbnail   String? @db.Text
  description String? @db.Text
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("product_types")
}

model Collection {
  id                   String           @id @default(uuid())
  name                 String
  slug                 String           @unique
  description          String? @db.Text
  shortDescription     String? @db.Text
  seoTitle             String? @db.Text
  seoDescription       String? @db.Text
  seoKeywords          String? @db.Text
  desktopBanner        String? @db.Text
  desktopBannerPublicId String?
  mobileBanner         String? @db.Text
  thumbnail            String? @db.Text
  thumbnailPublicId    String?
  isFeatured           Boolean          @default(false)
  isHomepage           Boolean          @default(false)
  isTrending           Boolean          @default(false)
  isSeasonal           Boolean          @default(false)
  isActive             Boolean          @default(true)
  isVisible            Boolean          @default(true)
  status               CollectionStatus @default(PUBLISHED)
  sortOrder            Int              @default(0)
  images               Json @default("[]")
  theme                String?
  products             Product[]        @relation("ProductToCollection")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  @@index([status])
  @@index([deletedAt])
  @@map("collections")
}

model Device {
  id        String    @id @default(uuid())
  name      String
  brand     String
  slug      String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("devices")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
  OUT_OF_STOCK
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum CompatibilityStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

model Product {
  id                 String           @id @default(uuid())
  name               String
  slug               String?          @unique
  shortDescription   String? @db.Text
  description        String @db.Text
  price              Float
  originalPrice      Float
  costPrice          Float?           @default(0.0)
  taxClass           String?          @default("Standard")
  sku                String?          @unique
  barcode            String?
  hsnCode            String?
  status             ProductStatus    @default(PUBLISHED)
  isSale             Boolean          @default(false)
  isNew              Boolean          @default(false)
  isBestSeller       Boolean          @default(false)
  isTrending         Boolean          @default(false)
  isFeatured         Boolean          @default(false)
  isHomepage         Boolean          @default(true)
  isRecommended      Boolean          @default(true)
  visibleInSearch    Boolean          @default(true)
  visibleInShop      Boolean          @default(true)
  allowBackorder     Boolean          @default(false)
  lowStockThreshold  Int              @default(10)
  tags               Json @default("[]")
  seoTitle           String? @db.Text
  seoDescription     String? @db.Text
  seoKeywords        String? @db.Text
  image              String           @db.Text // Primary thumbnail URL
  hoverImage         String?          @db.Text // Optional Hover Image URL
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productTypeId      String?
  productType        ProductType?     @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  minOrderQty        Int              @default(1)
  collections        Collection[]     @relation("ProductToCollection")
  supportedMaterials Json @default("[]")
  supportedFinishes  Json @default("[]")
  supportedCoverages Json @default("[]")
  deletedAt          DateTime?        // For catalog soft deletes
  isPublished        Boolean          @default(true)
  requiresDeviceSelection Boolean     @default(true)

  images             ProductImage[]
  variants           ProductVariant[]
  inventories        Inventory[]
  inventoryHistories InventoryHistory[]
  wishlistedBy       WishlistItem[]
  reviews            Review[]
  models             Model[]              @relation("ProductToModel")
  devicePreviews     DevicePreviewImage[]
  devicePrices       ProductDevicePrice[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([categoryId])
  @@index([productTypeId])
  @@index([status])
  @@index([slug])
  @@index([sku])
  @@index([isSale, isNew, isBestSeller, isTrending, isFeatured])
  @@index([deletedAt, isPublished])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String @db.Text
  publicId  String?
  position  Int      @default(0) // Sorting order
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_images")
}

model GlobalProductMockup {
  id                   String   @id @default("global-mockup")
  defaultFrontUrl      String?
  defaultFrontPublicId String?
  defaultBackUrl       String?
  defaultBackPublicId  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("global_product_mockups")
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku            String      @unique
  finish         String      // e.g. Matte, Glossy
  material       String      // e.g. Carbon Fiber, Leather
  priceOffset    Float       @default(0.0) // Adjusts base product price
  stockQuantity  Int         @default(0)
  reservedStock  Int         @default(0)
  image          String? @db.Text
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]
  reservations       ReservationItem[]
  inventory          Inventory?
  inventoryHistories InventoryHistory[]
  stockAdjustments   StockAdjustment[]

  @@index([sku])
  @@map("product_variants")
}

// ── Cart & Wishlist Domain ──

model WishlistItem {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([userId, productVariantId]) // Prevent duplicates of same variant
  @@map("wishlist_items")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id               String         @id @default(uuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  quantity         Int            @default(1)
  deviceTypeId     String?
  deviceType       DeviceType?    @relation(fields: [deviceTypeId], references: [id], onDelete: SetNull)
  modelId          String?
  model            Model?         @relation(fields: [modelId], references: [id], onDelete: SetNull)
  customModelName  String?        @db.VarChar(255)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, productVariantId, modelId], map: "cart_items_cartId_productVariantId_modelId_key")
  @@index([deviceTypeId], map: "cart_items_deviceTypeId_fkey")
  @@map("cart_items")
}

// ── Checkout & Payment Domain ──

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  subtotal          Float
  discount          Float                @default(0.0)
  tax               Float                @default(0.0)
  shippingFee       Float                @default(0.0)
  total             Float
  status            OrderStatus          @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus        @default(PENDING)
  fulfillmentStatus FulfillmentStatus    @default(UNFULFILLED)
  priority          OrderPriority        @default(NORMAL)
  shippingAddress   Json                 // Immutable snapshot of Address values at order time
  customerSnapshot  Json                 // Snapshot of User details at order time
  pricingSnapshot   Json                 // Details breakdown snapshot of subtotal, tax, shipping, discount
  couponCode        String?
  couponId          String?
  trackingNumber    String?
  courierName       String?
  courierLink       String?
  estimatedDelivery DateTime?
  invoiceNumber     String?
  invoiceUrl        String?
  invoiceGeneratedAt DateTime?
  customerNotes     String? @db.Text
  isArchived        Boolean              @default(false)
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  timelineEvents   OrderTimelineEvent[]
  payments         Payment[]
  shipments        Shipment[]
  notes            OrderNote[]
  reviews          Review[]

  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([userId, status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderNote {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String   @default("Admin")
  content    String @db.Text
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@map("order_notes")
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  quantity         Int
  pricePaid        Float          // Snapshotted price at order checkout time
  productName      String
  variantName      String
  sku              String
  categoryName     String?
  collectionName   String?
  deviceName       String?
  brandName        String?
  deviceType       String?
  deviceBrand      String?
  deviceModel      String?
  customModelName  String?        @db.VarChar(255)
  material         String?
  finish           String?
  coverage         String?
  unitPrice        Float
  unitDiscount     Float          @default(0.0)
  couponAllocation Float          @default(0.0)
  taxPercentage    Float          @default(0.0)
  imageUrl         String? @db.Text
  designJson       Json?
  createdAt        DateTime       @default(now())

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  comment   String?     @db.Text // e.g. "Package left at door"
  note      String? @db.Text
  updatedBy String?     @default("Admin")
  createdAt DateTime    @default(now())

  @@map("order_status_histories")
}

model Payment {
  id                String         @id @default(uuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  gateway           PaymentGateway @default(RAZORPAY)
  status            PaymentStatus  @default(PENDING)
  amount            Float
  currency          String         @default("INR")
  paymentMethod     String?        // e.g. upi, card, netbanking, wallet, emi
  stripePaymentId   String?        @unique
  razorpayPaymentId String?        @unique
  razorpayOrderId   String?
  razorpaySignature String?
  gatewayOrderId    String?
  gatewayPaymentId  String?        @unique
  gatewaySignature  String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  attempts          PaymentAttempt[]
  refunds           Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("payments")
}

model Refund {
  id             String   @id @default(uuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount         Float
  reason         String @db.Text
  gatewayRefundId String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("refunds")
}

enum ShipmentStatus {
  BOOKED
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

model Shipment {
  id                String         @id @default(uuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier           String         @default("NOT_CONFIGURED")
  trackingNumber    String         @unique
  shipmentId        String         @unique
  shippingLabelUrl  String?
  status            ShipmentStatus @default(BOOKED)
  dispatchDate      DateTime?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

// ── Marketing & Operations Domain ──

model Coupon {
  id                      String         @id @default(uuid())
  code                    String         @unique
  name                    String         @default("")
  description             String? @db.Text
  discountType            DiscountType   @default(PERCENTAGE)
  discountValue           Float          @default(0.0)
  status                  CouponStatus   @default(ACTIVE)
  startDate               DateTime?
  endDate                 DateTime?
  priority                Int            @default(0)
  internalNotes           String? @db.Text
  usageCount              Int            @default(0)
  totalDiscountGiven      Float          @default(0.0)

  // Legacy compatibility fields
  validFrom               DateTime?
  validUntil              DateTime?
  maxDiscount             Float?
  minCartValue            Float?         @default(0.0)
  globalUsageLimit        Int?
  perUserUsageLimit       Int?           @default(1)
  isActive                Boolean        @default(true)
  firstOrderOnly          Boolean        @default(false)
  applicableCategoryIds   Json @default("[]")
  applicableCollectionIds Json @default("[]")
  applicableProductIds    Json @default("[]")
  applicableDeviceIds     Json @default("[]")
  excludedProductIds      Json @default("[]")

  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  carts                   Cart[]
  usages                  CouponUsage[]
  rules                   CouponRules?
  targets                 CouponTargets?

  @@index([code])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("coupons")
}

model CouponRules {
  id                  String   @id @default(uuid())
  couponId            String   @unique
  coupon              Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  minOrderValue       Float    @default(0.0)
  maxDiscountAmount   Float?
  globalUsageLimit    Int?
  perUserUsageLimit   Int?     @default(1)
  firstOrderOnly      Boolean  @default(false)
  excludeSaleProducts Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("coupon_rules")
}

model CouponTargets {
  id            String   @id @default(uuid())
  couponId      String   @unique
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  targetScope   String   @default("STOREWIDE") // "STOREWIDE", "COLLECTIONS", "PRODUCTS", "CATEGORIES", "BRANDS"
  collectionIds Json @default("[]")
  productIds    Json @default("[]")
  categoryIds   Json @default("[]")
  brandIds      Json @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("coupon_targets")
}

model CouponUsage {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId        String?
