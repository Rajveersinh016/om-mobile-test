// ── Inventory Reservation Domain ──

enum ReservationStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model InventoryReservation {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  items     ReservationItem[]

  @@index([userId, status])
  @@index([expiresAt, status])
  @@map("inventory_reservations")
}

model ReservationItem {
  id               String               @id @default(uuid())
  reservationId    String
  reservation      InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  productVariantId String
  variant          ProductVariant       @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  quantity         Int

  @@unique([reservationId, productVariantId])
  @@map("reservation_items")
}

model PaymentAttempt {
  id                      String        @id @default(uuid())
  paymentId               String
  payment                 Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status                  PaymentStatus
  transactionId           String?
  signature               String?
  errorMessage            String? @db.Text
  providerResponseCode    String?
  providerResponseMessage String? @db.Text
  rawPayload              Json?
  createdAt               DateTime      @default(now())

  @@map("payment_attempts")
}

model IdempotencyKey {
  key          String   @id
  requestHash  String   // SHA-256 hash of the request body payload
