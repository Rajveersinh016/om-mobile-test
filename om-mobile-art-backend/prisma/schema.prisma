// ── Inventory Management Domain ──

model Inventory {
  id               String         @id @default(uuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId String         @unique
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  sku              String         @unique
  barcode          String?
  hsnCode          String?
  quantity         Int            @default(0) // Current Stock
  reserved         Int            @default(0) // Reserved Stock
  incoming         Int            @default(0) // Incoming Stock
  minStockLevel    Int            @default(5) // Low Stock Alert threshold
  maxStockLevel    Int            @default(100) // Maximum Stock Level
  safetyStock      Int            @default(2) // Safety Stock
  allowBackorder   Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  histories        InventoryHistory[]
  adjustments      StockAdjustment[]

  @@index([sku])
  @@index([productId])
  @@index([productVariantId])
  @@map("inventories")
}

model InventoryHistory {
  id               String         @id @default(uuid())
  inventoryId      String?
  inventory        Inventory?     @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  oldQuantity      Int
  newQuantity      Int
  difference       Int
  reason           String @db.Text
  actionType       String         @default("ADJUSTMENT") // "INCREASE", "DECREASE", "SET", "TRANSFER", "ADJUSTMENT", "BULK_UPDATE", "RESERVATION", "ORDER_DEDUCTION"
  adminUserId      String?
  adminName        String?
  createdAt        DateTime       @default(now())

  @@index([productId])
  @@index([productVariantId])
  @@index([createdAt(sort: Desc)])
  @@map("inventory_histories")
}

model StockAdjustment {
  id               String         @id @default(uuid())
  inventoryId      String
  inventory        Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  type             String         // "INCREASE", "DECREASE", "SET", "TRANSFER", "DAMAGE", "RESTOCK", "AUDIT"
  quantity         Int
  reason           String @db.Text
  referenceNumber  String?
  performedById    String?
  createdAt        DateTime       @default(now())

  @@index([productVariantId])
  @@index([inventoryId])
  @@map("stock_adjustments")
}

